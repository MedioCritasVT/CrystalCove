# Local static content server. TLS/public DNS belong to a separately reviewed reverse proxy.
{
    admin off
    auto_https off
}

:8080 {
    root * /srv
    encode zstd gzip
    file_server

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
